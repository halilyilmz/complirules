{
  "name": "complirules-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Compliance-as-Code & Legal AI Guardrail Engine for Vibe Coding & Agentic SWE",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
